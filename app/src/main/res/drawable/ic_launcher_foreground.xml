<?xml version="1.0" encoding="utf-8"?>
<!--
    The CarTally mark: a fuel drop with a speedometer cut through it.

    The gauge is a hole, not petrol paint on amber. Themed icons (Android 13+)
    recolour every opaque pixel to one tint, so a painted gauge would vanish
    into a plain blob; a hole shows the background whatever colour it is. That
    is also why the monochrome layer can reuse this drawable as it stands.

    Coordinates are the mockup's, relative to the centre of the drop's round
    base, where the drop is 256 wide. The group scales them into the 108dp
    layer so the drop fills 58.9% of the 72dp visible tile, as in the mockup.
    Its farthest point is 21.9dp from the centre - well inside the 33dp safe
    radius - so no launcher mask shape clips it.

    Traced against the mockup at 99.4% pixel overlap. The gauge is one outline
    (arc, needle and hub together) so the even-odd fill can cut it out: three
    overlapping holes would cancel each other where they cross.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="54"
        android:translateY="60.69"
        android:scaleX="0.118515"
        android:scaleY="0.118515">
        <path
            android:fillColor="#F2A531"
            android:fillType="evenOdd"
            android:pathData="M0,-230C4.7,-228.29 77.08,-139.53 116.48,-53.08A128,128 0 1,1 -116.48,-53.08C-77.08,-139.53 -4.7,-228.29 0,-230ZM91,8A91,91 0 0,0 -91,8A11,11 0 0,0 -69,8A69,69 0 0,1 38.71,-49.12L3.45,-11.7A20,20 0 1,0 19.46,3.39L54.72,-34.03A69,69 0 0,1 69,8A11,11 0 0,0 91,8Z" />
    </group>
</vector>
