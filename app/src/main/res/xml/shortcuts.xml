<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: straight to the fill-up form. The package is
     spelled out because the launcher, not the app, reads this intent. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="log_fill_up"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_fill_up"
        android:shortcutShortLabel="@string/shortcut_fill_up_short"
        android:shortcutLongLabel="@string/shortcut_fill_up_long">
        <intent
            android:action="se.eliash.cartracker.LOG_FILL_UP"
            android:targetPackage="se.eliash.cartracker"
            android:targetClass="se.eliash.cartracker.MainActivity" />
    </shortcut>
</shortcuts>
